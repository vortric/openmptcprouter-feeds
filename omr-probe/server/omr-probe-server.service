[Unit]
Description=OMR survey probe server (UDP echo + HTTP down/up)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/omr-probe-server.py
Restart=always
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
