#!/bin/sh
# /usr/libexec/rpcd/radio -- serve omr-radiod's latest phone telemetry over ubus.
# SPDX-License-Identifier: GPL-2.0-only
#   ubus call radio get     -> per-interface: connected, peer, counters, last line (raw)
#   ubus call radio status  -> per-interface connected + age

STATE=$(uci -q get omr-radio.settings.state_file)
STATE="${STATE:-/tmp/radio/state.json}"

case "$1" in
	list) echo '{ "get": {}, "status": {} }' ;;
	call)
		case "$2" in
			get)
				cat >/dev/null
				if [ -s "$STATE" ]; then cat "$STATE"; else echo '{"error":"no state file (omr-radiod not running?)"}'; fi ;;
			status)
				cat >/dev/null
				if [ -s "$STATE" ]; then
					wr=$(jsonfilter -i "$STATE" -e '@.clock_realtime_ns')
					printf '{"running":true,"interfaces":{'
					first=1
					# shellcheck disable=SC2013
					for i in $(grep -oE '"[A-Za-z0-9_.-]+":\{"connected"' "$STATE" | cut -d'"' -f2); do
						[ "$first" = 1 ] && first=0 || printf ','
						last=$(jsonfilter -i "$STATE" -e "@.interfaces['$i'].last_recv_realtime_ns"); age=$(( (${wr:-0} - ${last:-0}) / 1000000 )); [ "${last:-0}" = "0" ] && age=-1
						printf '"%s":{"connected":%s,"peer":"%s","lines":%s,"last_age_ms":%s}' "$i" "$(jsonfilter -i "$STATE" -e "@.interfaces['$i'].connected")" "$(jsonfilter -i "$STATE" -e "@.interfaces['$i'].peer")" "$(jsonfilter -i "$STATE" -e "@.interfaces['$i'].lines")" "$age"
					done
					echo '}}'
				else echo '{"running":false}'; fi ;;
			*) echo '{"error": "unknown method"}'; exit 1 ;;
		esac ;;
esac
