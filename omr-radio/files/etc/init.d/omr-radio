#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

# shellcheck disable=SC2034
START=95
STOP=11
USE_PROCD=1

IFACE_ARGS=""

_add_iface() { [ -n "$1" ] && IFACE_ARGS="$IFACE_ARGS -i $1"; }

_wan_devices() {
	local cfg="$1" mode dev
	case "$cfg" in wan*) ;; *) return 0 ;; esac
	config_get mode "$cfg" multipath ""
	[ -z "$mode" ] && mode="$(uci -q get openmptcprouter."$cfg".multipath)"
	case "$mode" in on|master|backup) ;; *) return 0 ;; esac
	config_get dev "$cfg" device ""
	_add_iface "$dev"
}

start_service() {
	local enabled port state_file rawlog_dir survey_base
	config_load omr-radio
	config_get_bool enabled settings enabled 1
	[ "$enabled" = "1" ] || return 0
	config_get port settings port '8630'
	config_get state_file settings state_file '/tmp/radio/state.json'
	config_get rawlog_dir settings rawlog_dir ''
	config_list_foreach settings interface _add_iface
	if [ -z "$IFACE_ARGS" ]; then
		config_load network
		config_foreach _wan_devices interface
	fi
	[ -n "$IFACE_ARGS" ] || { logger -t omr-radio "no interfaces"; return 0; }
	[ -n "$rawlog_dir" ] && mkdir -p "$rawlog_dir"
	survey_base=$(uci -q get omr-survey.settings.base_dir)

	procd_open_instance main
	# shellcheck disable=SC2086
	procd_set_param command /usr/sbin/omr-radiod -p "$port" -s "$state_file" -r "$rawlog_dir" -S "${survey_base:-/tmp/omr-survey}" $IFACE_ARGS
	procd_set_param respawn 3600 5 0
	# exits by itself after 60 s without any peer (self-heal), so respawn must stay on
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger omr-radio network
}
